<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Admin.Faculty.UpdateTeacher">

    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:id="@+id/updateTeacherImg"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/img"
        android:layout_marginTop="36dp">
    </de.hdodenhof.circleimageview.CircleImageView>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="name"
        android:inputType="text"
        android:layout_marginTop="16dp"
        android:id="@+id/updateTeacherName"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Department"
        android:inputType="text"
        android:layout_marginTop="16dp"
        android:id="@+id/updateTeacherDepartment"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="email"
        android:inputType="textEmailAddress"
        android:layout_marginTop="16dp"
        android:id="@+id/updateTeacherEmail"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="post"
        android:inputType="text"
        android:layout_marginTop="16dp"
        android:id="@+id/updateTeacherPost"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="pass"
        android:inputType="text"
        android:layout_marginTop="16dp"
        android:id="@+id/updateTeacherPass"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:layout_marginTop="26dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update"
            android:layout_marginRight="8dp"
            android:textAllCaps="false"
            android:id="@+id/updateTeacherBtn">
        </com.google.android.material.button.MaterialButton>
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete"
            android:textAllCaps="false"
            android:layout_marginLeft="8dp"
            android:id="@+id/deleteTeacherBtn">
        </com.google.android.material.button.MaterialButton>
    </LinearLayout>


</LinearLayout>